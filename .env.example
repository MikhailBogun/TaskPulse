# Rails
RAILS_MASTER_KEY=your_master_key_here
RAILS_ENV=development
SECRET_KEY_BASE=

# JWT
DEVISE_JWT_SECRET_KEY=your_jwt_secret_here

# Database (overridden by DATABASE_URL in Docker)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379/0

# Frontend
FRONTEND_URL=http://localhost:5173

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# SendGrid
SENDGRID_API_KEY=SG....
MAILER_FROM=noreply@taskpulse.io
SUPPORT_EMAIL=support@taskpulse.io

# GitHub API
GITHUB_ACCESS_TOKEN=ghp_...

# Telegram Bot
TELEGRAM_BOT_TOKEN=...

# Slack
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# CoinGecko (no key needed for free tier)

# AWS / LocalStack
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ENDPOINT=http://localhost:4566
AWS_S3_BUCKET=taskpulse-dev

# Render.com (for CI/CD deploy)
RENDER_DEPLOY_HOOK_URL=
